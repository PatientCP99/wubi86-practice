# tools/raw/ 是源代码表的下载缓存（2.4 MB），build_data.py 会自动重新下载，
# 而且其中的字表转录仓库没有附许可，不适合再分发 —— 所以不入库。
tools/raw/

# data/local/ 是「精确字根拆解」的本地生成产物（拆解数据 + 字根字体，约 585 KB）。
# 来源 hantang/search-wubi 没有许可文件，字体也疑似 SimHei 子集 —— 不能随仓库分发。
# 它由 tools/fetch_rootunits.py 生成，跑一次就有。
data/local/

# 视觉工具（DSH vision toolkit）的裁剪/描摹/对比产物：属于本地工作痕迹，不是项目内容。
# 用一次 vision_crop / vision_trace / pixel_diff 就会在这里落文件，别让它们进提交。
.dsh-vision-toolkit/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时产物
*.tmp
*.log
